<Window x:Class="StudentManagementSystem.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="360" Width="440"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
        <Border Background="{StaticResource PrimaryLightBrush}"
                CornerRadius="12" Padding="12"
                Width="56" Height="56"
                HorizontalAlignment="Center"
                Margin="0,0,0,16">
            <TextBlock Text="&#x1F393;" FontSize="28"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Text="Student Management System"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>

        <TextBlock Text="Version 1.0.0"
                   FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center">
                    A complete academic administration system with student records,
                    courses, enrollments, result computation, attendance tracking,
                    timetables, payments, and reporting.
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,12,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center">
                    Built with .NET 8, WPF, EF Core &amp; PostgreSQL
                </TextBlock>
            </StackPanel>
        </Border>

        <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}"
                Click="Close_Click" Width="120" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
