<Window x:Class="StudentManagementSystem.Views.CourseFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course Form" Height="460" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding IsEdit, Converter={StaticResource CourseFormTitleConverter}}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="6"
                        Padding="10,4">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="{}{Binding IsEdit, Converter={StaticResource CourseFormTitleConverter}, FallbackValue=New Course}"/>
                    </TextBlock>
                </Border>
            </DockPanel>
        </Border>

        <!-- Form Fields -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">
            <!-- Course Code -->
            <TextBlock Text="Course Code" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding CourseCode, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>

            <!-- Course Name -->
            <TextBlock Text="Course Name" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>

            <!-- Credits / Department row -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Credits" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Credits, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Department" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Description -->
            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,14"/>

            <!-- Prerequisite Course -->
            <TextBlock Text="Prerequisite Course (optional)" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox ItemsSource="{Binding AvailableCourses}"
                      SelectedItem="{Binding SelectedPrerequisiteCourse}"
                      DisplayMemberPath="CourseName"
                      Style="{StaticResource ModernComboBoxStyle}"
                      Margin="0,0,0,14"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Error}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MaxWidth="280"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsValid, Converter={StaticResource InvertBoolConverter}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,10,0"/>
                    <Button Content="Save Course"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"
                            IsDefault="True"
                            MinWidth="110"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
