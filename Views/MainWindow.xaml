<Window x:Class="StudentManagementSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib"
        xmlns:converters="clr-namespace:StudentManagementSystem.Converters"
        Title="Student Management System" Height="700" Width="1140"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8"
                        Padding="8"
                        Width="36" Height="36"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#x1F393;"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Student Management System"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Academic Administration Portal"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="NotificationBell" Background="{StaticResource BackgroundBrush}"
                            CornerRadius="6" Padding="8,4" Margin="0,0,10,0"
                            Cursor="Hand" MouseLeftButtonDown="NotificationBell_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Popup x:Name="NotificationPopup" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=NotificationBell}"
                           Placement="Bottom" Width="320" MaxHeight="400"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="0" Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="12,10"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Notifications" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" MaxHeight="350"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="NotificationItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,8" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Message}" FontSize="12"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Popup>

                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F464;"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Margin="6,0,0,0">
                                <TextBlock Text="{Binding CurrentUserRole}"
                                           FontSize="10"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="About"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AboutCommand}"
                            FontSize="12"
                            Padding="10,6"
                            Margin="0,0,8,0"/>
                    <Button Content="Logout"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            FontSize="12"
                            Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource ModernTabControlStyle}"
                    Margin="20">
            <!-- ==================== STUDENTS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="StudentsTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Students"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                MinWidth="24">
                            <TextBlock Text="{Binding Students.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="+ Register Student"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenAddStudentCommand}"/>
                                <Button Content="Edit"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenEditStudentCommand}"
                                        Margin="8,0,0,0"/>
                                <Button Content="Transcript"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenTranscriptCommand}"
                                        Margin="8,0,0,0"/>
                                <Button Content="Delete"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteStudentCommand}"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <DockPanel HorizontalAlignment="Right" Width="260">
                                <Button DockPanel.Dock="Right"
                                        Content="Search"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding SearchStudentsCommand}"
                                        Margin="8,0,0,0"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <!-- Stats -->
                    <TextBlock Grid.Row="1"
                                Margin="4,10,0,6"
                                FontSize="12"
                                Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding StudentPageInfo, FallbackValue='Showing 0 students', Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Reg. No."
                                                Binding="{Binding RegistrationNumber}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Full Name"
                                                Binding="{Binding FullName}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding Department}"
                                                Width="170"/>
                            <DataGridTextColumn Header="D.O.B"
                                                Binding="{Binding DateOfBirth}"
                                                Width="170"/>   
                            <DataGridTextColumn Header="Gender"
                                                Binding="{Binding Gender}"
                                                Width="130"/>   
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Phone"
                                                Binding="{Binding Phone}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Address"
                                                Binding="{Binding Address}"
                                                Width="210"/>
                            <DataGridTextColumn Header="Enrolled"
                                Binding="{Binding EnrollmentDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                 Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="Per page:" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding PageSizes}"
                                  SelectedItem="{Binding StudentPageSize}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="70"/>
                        <Button Content="Prev"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="12" Padding="8,4" Margin="12,0,4,0"
                                Click="StudentPrevPage_Click"/>
                        <Button Content="Next"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="12" Padding="8,4"
                                Click="StudentNextPage_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== COURSES TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="CoursesTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Courses"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                MinWidth="24">
                            <TextBlock Text="{Binding Courses.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Add Course"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenAddCourseCommand}"/>
                            <Button Content="Edit"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenEditCourseCommand}"
                                    Margin="8,0,0,0"/>
                            <Button Content="Delete"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteCourseCommand}"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Margin="4,10,0,6"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Showing"/>
                        <Run Text="{Binding Courses.Count, FallbackValue=0, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="course(s)"/>
                    </TextBlock>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Courses}"
                              SelectedItem="{Binding SelectedCourse}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding CourseCode}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Course Name"
                                                Binding="{Binding CourseName}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Credits"
                                                Binding="{Binding Credits}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding Department}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Prerequisite"
                                                Binding="{Binding PrerequisiteCourse.CourseCode}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ==================== ENROLLMENTS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="EnrollmentsTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Enrollments"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                MinWidth="24">
                            <TextBlock Text="{Binding Enrollments.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Enrollment Form -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="New Enrollment"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <DockPanel Grid.Row="1">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <StackPanel Width="200">
                                        <TextBlock Text="Student"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding StudentsForEnroll}"
                                                  SelectedItem="{Binding SelectedStudentForEnroll}"
                                                  DisplayMemberPath="FullName"
                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="12,0,0,0">
                                        <TextBlock Text="Course"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding CoursesForEnroll}"
                                                  SelectedItem="{Binding SelectedCourseForEnroll}"
                                                  DisplayMemberPath="CourseName"
                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="12,0,0,0">
                                        <TextBlock Text="Semester"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding SemesterList}"
                                                  Text="{Binding Semester}"
                                                  IsEditable="True"
                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Enroll Student"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding EnrollStudentCommand}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Enrollment List -->
                    <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource BackgroundBrush}"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Remove Enrollment"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding RemoveEnrollmentCommand}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="Save Grade"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveGradeCommand}"
                                        Margin="8,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBlock Text="From:" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,4,0"/>
                                    <DatePicker SelectedDate="{Binding EnrollmentFilterFrom}"
                                                Style="{StaticResource ModernDatePickerStyle}"
                                                Width="130" Margin="0,0,8,0"/>
                                    <TextBlock Text="To:" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,4,0"/>
                                    <DatePicker SelectedDate="{Binding EnrollmentFilterTo}"
                                                Style="{StaticResource ModernDatePickerStyle}"
                                                Width="130" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding GradeStatusFilters}"
                                              SelectedItem="{Binding EnrollmentStatusFilter}"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Width="90"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Margin="4,10,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="Showing"/>
                            <Run Text="{Binding Enrollments.Count, FallbackValue=0, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="enrollment(s)"/>
                        </TextBlock>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Enrollments}"
                                  SelectedItem="{Binding SelectedEnrollment}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  AlternatingRowBackground="#F9FAFB"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Reg. No." Binding="{Binding RegistrationNumber}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Course Code" Binding="{Binding CourseCode}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Course" Binding="{Binding CourseName}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="70"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding EnrollmentDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- ==================== ATTENDANCE TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="AttendanceTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Attendance"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10" Padding="6,2"
                                Margin="8,0,0,0" MinWidth="24">
                            <TextBlock Text="{Binding AttendanceRecords.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Attendance Form -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Mark Attendance"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <StackPanel Width="220">
                                    <TextBlock Text="Course" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding CoursesForEnroll}"
                                              SelectedItem="{Binding SelectedCourseForAttendance}"
                                              DisplayMemberPath="CourseName"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="160" Margin="12,0,0,0">
                                    <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding AttendanceDate}"
                                                Style="{StaticResource ModernDatePickerStyle}"/>
                                </StackPanel>
                                <Button Content="Save Attendance"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveAttendanceCommand}"
                                        VerticalAlignment="Bottom"
                                        Margin="16,0,0,0"/>
                                <Button Content="Export PDF"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ExportAttendancePdf_Click"
                                        VerticalAlignment="Bottom"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Attendance Entries + History -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Today's Attendance"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="4,0,0,6"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding AttendanceEntries}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  AlternatingRowBackground="#F9FAFB" AlternationCount="2"
                                  MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Reg. No." Binding="{Binding RegistrationNumber}" Width="100" IsReadOnly="True"/>
                                <DataGridComboBoxColumn Header="Status" SelectedItemBinding="{Binding Status}" Width="120">
                                    <DataGridComboBoxColumn.ItemsSource>
                                        <collections:ArrayList>
                                            <sys:String>Present</sys:String>
                                            <sys:String>Absent</sys:String>
                                            <sys:String>Late</sys:String>
                                            <sys:String>Excused</sys:String>
                                        </collections:ArrayList>
                                    </DataGridComboBoxColumn.ItemsSource>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="Attendance History"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="4,10,0,6"/>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding AttendanceRecords}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False"
                                  AlternatingRowBackground="#F9FAFB" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="150"/>
                                <DataGridTextColumn Header="Reg. No." Binding="{Binding RegistrationNumber}" Width="90"/>
                                <DataGridTextColumn Header="Course" Binding="{Binding CourseCode}" Width="90"/>
                                <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="150"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- ==================== TIMETABLE TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="TimetableTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Timetable"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10" Padding="6,2"
                                Margin="8,0,0,0" MinWidth="24">
                            <TextBlock Text="{Binding Schedules.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add Schedule Form -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Add Schedule"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"/>
                            <WrapPanel Grid.Row="1">
                                <StackPanel Width="170" Margin="0,0,10,0">
                                    <TextBlock Text="Course" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding ScheduleCourses}"
                                              SelectedItem="{Binding SelectedScheduleCourse}"
                                              DisplayMemberPath="CourseName"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,0">
                                    <TextBlock Text="Day" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Days}"
                                              SelectedItem="{Binding ScheduleDay}"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Start" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding ScheduleStartTime}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="End" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding ScheduleEndTime}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,0">
                                    <TextBlock Text="Room" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding ScheduleRoom, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="Instructor" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding ScheduleInstructor, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <Button Content="+ Add"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddScheduleCommand}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Filter -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,6">
                        <TextBlock Text="Filter:" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding FilterDays}"
                                  SelectedItem="{Binding ScheduleFilterDay}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="130"/>
                        <Button Content="Delete"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteScheduleCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                FontSize="12" Padding="10,6"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Schedules}"
                              SelectedItem="{Binding SelectedSchedule}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Course Code" Binding="{Binding Course.CourseCode}" Width="100"/>
                            <DataGridTextColumn Header="Course" Binding="{Binding Course.CourseName}" Width="180"/>
                            <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeek}" Width="110"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="100"/>
                            <DataGridTextColumn Header="Instructor" Binding="{Binding Instructor}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- ==================== DASHBOARD TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="DashboardTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Stats Cards -->
                    <WrapPanel Grid.Row="0">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                Padding="18,14" Margin="0,0,12,12" MinWidth="180"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Total Students" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DashboardTotalStudents}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                Padding="18,14" Margin="0,0,12,12" MinWidth="180"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Total Courses" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DashboardTotalCourses}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                Padding="18,14" Margin="0,0,12,12" MinWidth="180"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Enrollments" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DashboardTotalEnrollments}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                Padding="18,14" Margin="0,0,12,12" MinWidth="180"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Avg GPA" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DashboardAvgGpa, StringFormat={}{0:F2}}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                Padding="18,14" Margin="0,0,12,12" MinWidth="180"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Active Semesters" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DashboardActiveSemesters}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                Padding="18,14" Margin="0,0,12,12" MinWidth="200"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Top Department" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DashboardTopDept}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding DashboardTopDeptCount}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Export Section -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8" Padding="20" VerticalAlignment="Top"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Data Export &amp; Import"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Export data to CSV/PDF files or import students/courses from CSV."
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,14"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Export Students (CSV)"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExportStudentsCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Export Enrollments (CSV)"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExportEnrollmentsCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Export Payments (PDF)"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ExportPaymentsPdf_Click"
                                        Margin="0,0,10,0"/>
                                <Button Content="Import Students"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ImportStudentsCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Import Courses"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ImportCoursesCommand}"
                                        Margin="0,0,10,0"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="Seed Sample Data"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding SeedSampleDataCommand}"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Department Distribution -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="20"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Students by Department"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding DepartmentStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Department}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Height="14"
                                                    Background="{StaticResource BackgroundBrush}"
                                                    CornerRadius="7" Margin="8,0"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Border Background="{StaticResource PrimaryBrush}"
                                                            CornerRadius="7"
                                                            HorizontalAlignment="Left"
                                                            Width="{Binding Percentage, Converter={StaticResource PercentageToWidthConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <!-- ==================== PAYMENTS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="PaymentsTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Payments"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10" Padding="6,2"
                                Margin="8,0,0,0" MinWidth="24">
                            <TextBlock Text="{Binding Payments.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Payment Form -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Record Payment"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"/>
                            <WrapPanel Grid.Row="1">
                                <StackPanel Width="200" Margin="0,0,10,0">
                                    <TextBlock Text="Student" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding PaymentStudents}"
                                              SelectedItem="{Binding SelectedPaymentStudent}"
                                              DisplayMemberPath="FullName"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,0">
                                    <TextBlock Text="Amount ($)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="Method" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding PaymentMethods}"
                                              SelectedItem="{Binding PaymentMethod}"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,0">
                                    <TextBlock Text="Semester" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding PaymentSemester, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,0">
                                    <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding PaymentDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <Button Content="Record Payment"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddPaymentCommand}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Total -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Collected: " FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                                <Run Text="$"/><Run Text="{Binding TotalPayments, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                            <Button Content="Delete" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeletePaymentCommand}"
                                    HorizontalAlignment="Right" Margin="16,0,0,0"
                                    FontSize="12" Padding="10,6"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Payments}"
                              SelectedItem="{Binding SelectedPayment}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student" Binding="{Binding Student.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Reg. No." Binding="{Binding Student.RegistrationNumber}" Width="90"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="90"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="100"/>
                            <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- ==================== USERS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="UsersTab_Loaded"
                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Users"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10" Padding="6,2"
                                Margin="8,0,0,0" MinWidth="24">
                            <TextBlock Text="{Binding Users.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <WrapPanel>
                            <StackPanel Width="140" Margin="0,0,8,0">
                                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,8,0">
                                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="140" Margin="0,0,8,0">
                                <TextBlock Text="Display Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="100" Margin="0,0,8,0">
                                <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Roles}"
                                          SelectedItem="{Binding NewRole}"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="70" Margin="0,0,8,0" VerticalAlignment="Bottom">
                                <CheckBox IsChecked="{Binding NewIsActive}" Content="Active"
                                          VerticalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                <Button Content="Add User"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddUserCommand}"/>
                                <Button Content="Reset PW"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ResetPasswordCommand}"
                                        Margin="8,0,0,0"/>
                                <Button Content="Delete"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteUserCommand}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="160"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80"/>
                            <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- ==================== SEMESTERS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="SemestersTab_Loaded"
                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Semesters"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10" Padding="6,2"
                                Margin="8,0,0,0" MinWidth="24">
                            <TextBlock Text="{Binding Semesters.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <WrapPanel>
                            <StackPanel Width="180" Margin="0,0,10,0">
                                <TextBlock Text="Semester Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding SemesterName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,10,0">
                                <TextBlock Text="Start Date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding SemesterStart}"
                                            Style="{StaticResource ModernDatePickerStyle}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,10,0">
                                <TextBlock Text="End Date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding SemesterEnd}"
                                            Style="{StaticResource ModernDatePickerStyle}"/>
                            </StackPanel>
                            <StackPanel Width="70" Margin="0,0,10,0" VerticalAlignment="Bottom">
                                <CheckBox IsChecked="{Binding SemesterIsActive}" Content="Active"
                                          VerticalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                <Button Content="Add Semester"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddSemesterCommand}"/>
                                <Button Content="Delete"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteSemesterCommand}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Semesters}"
                              SelectedItem="{Binding SelectedSemester}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                            <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                            <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- ==================== RESULTS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="ResultsTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Results"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10" Padding="6,2"
                                Margin="8,0,0,0" MinWidth="24">
                            <TextBlock Text="{Binding ResultEntries.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Result Form -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="240">
                                <TextBlock Text="Course" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding CoursesForEnroll}"
                                          SelectedItem="{Binding SelectedCourseForResults}"
                                          DisplayMemberPath="CourseName"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="12,0,0,0">
                                <TextBlock Text="Semester" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding SemesterList}"
                                          Text="{Binding ResultSemester}"
                                          IsEditable="True"
                                          Style="{StaticResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="16,0,0,1">
                                <Button Content="Save Scores"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveScoresCommand}"
                                        Margin="0,0,10,0"/>
                                <Button Content="Publish Results"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PublishResultsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Summary -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="12"
                            Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding ResultSummary, FallbackValue=Select a course and semester to load results}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Score Entry Grid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding ResultEntries}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Reg. No." Binding="{Binding RegistrationNumber}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="CA (0-40)" Binding="{Binding CaScore}" Width="80"/>
                            <DataGridTextColumn Header="Exam (0-60)" Binding="{Binding ExamScore}" Width="90"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalScore}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="60" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="GP" Binding="{Binding GradePoint}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="IsPublished">
                                        <Binding.Converter>
                                            <converters:BoolToStatusConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="Signed in as: "/>
                    <Run Text="{Binding CurrentUserDisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="  ("/>
                    <Run Text="{Binding CurrentUserRole, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=")"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="Student Management System v1.0.0"/>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
