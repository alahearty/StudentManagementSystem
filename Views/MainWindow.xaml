<Window x:Class="StudentManagementSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System" Height="640" Width="1060"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8"
                        Padding="8"
                        Width="36" Height="36"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#x1F393;"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Student Management System"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="Academic Administration Portal"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource ModernTabControlStyle}"
                    Margin="20">
            <!-- ==================== STUDENTS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="StudentsTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Students"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                MinWidth="24">
                            <TextBlock Text="{Binding Students.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="+ Register Student"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenAddStudentCommand}"/>
                                <Button Content="Edit"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding OpenEditStudentCommand}"
                                        Margin="8,0,0,0"/>
                                <Button Content="Delete"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding DeleteStudentCommand}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                            <DockPanel HorizontalAlignment="Right" Width="260">
                                <Button DockPanel.Dock="Right"
                                        Content="Search"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding SearchStudentsCommand}"
                                        Margin="8,0,0,0"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <!-- Stats -->
                    <TextBlock Grid.Row="1"
                               Margin="4,10,0,6"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Showing"/>
                        <Run Text="{Binding Students.Count, FallbackValue=0, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="student(s)"/>
                    </TextBlock>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Reg. No."
                                                Binding="{Binding RegistrationNumber}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Full Name"
                                                Binding="{Binding FullName}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding Department}"
                                                Width="170"/>
                            <DataGridTextColumn Header="D.O.B"
                                                Binding="{Binding DateOfBirth}"
                                                Width="170"/>   
                            <DataGridTextColumn Header="Gender"
                                                Binding="{Binding Gender}"
                                                Width="130"/>   
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Phone"
                                                Binding="{Binding Phone}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Address"
                                                Binding="{Binding Address}"
                                                Width="210"/>
                            <DataGridTextColumn Header="Enrolled"
                                                Binding="{Binding EnrollmentDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ==================== COURSES TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="CoursesTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Courses"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                MinWidth="24">
                            <TextBlock Text="{Binding Courses.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Add Course"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenAddCourseCommand}"/>
                            <Button Content="Edit"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenEditCourseCommand}"
                                    Margin="8,0,0,0"/>
                            <Button Content="Delete"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteCourseCommand}"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Margin="4,10,0,6"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Showing"/>
                        <Run Text="{Binding Courses.Count, FallbackValue=0, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="course(s)"/>
                    </TextBlock>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Courses}"
                              SelectedItem="{Binding SelectedCourse}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              AlternatingRowBackground="#F9FAFB"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding CourseCode}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Course Name"
                                                Binding="{Binding CourseName}"
                                                Width="220"/>
                            <DataGridTextColumn Header="Credits"
                                                Binding="{Binding Credits}"
                                                Width="140"/>
                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding Department}"
                                                Width="190"/>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ==================== ENROLLMENTS TAB ==================== -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     Loaded="EnrollmentsTab_Loaded">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Enrollments"/>
                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="10"
                                Padding="6,2"
                                Margin="8,0,0,0"
                                MinWidth="24">
                            <TextBlock Text="{Binding Enrollments.Count, FallbackValue=0, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Enrollment Form -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="New Enrollment"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <DockPanel Grid.Row="1">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <StackPanel Width="200">
                                        <TextBlock Text="Student"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding StudentsForEnroll}"
                                                  SelectedItem="{Binding SelectedStudentForEnroll}"
                                                  DisplayMemberPath="FullName"
                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="12,0,0,0">
                                        <TextBlock Text="Course"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding CoursesForEnroll}"
                                                  SelectedItem="{Binding SelectedCourseForEnroll}"
                                                  DisplayMemberPath="CourseName"
                                                  Style="{StaticResource ModernComboBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="12,0,0,0">
                                        <TextBlock Text="Semester"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding Semester, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Enroll Student"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding EnrollStudentCommand}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- Enrollment List -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource BackgroundBrush}"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Remove Enrollment"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding RemoveEnrollmentCommand}"/>
                                <Button Content="Save Grade"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveGradeCommand}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Margin="4,10,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="Showing"/>
                            <Run Text="{Binding Enrollments.Count, FallbackValue=0, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="enrollment(s)"/>
                        </TextBlock>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Enrollments}"
                                  SelectedItem="{Binding SelectedEnrollment}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  AlternatingRowBackground="#F9FAFB"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Reg. No." Binding="{Binding RegistrationNumber}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Course Code" Binding="{Binding CourseCode}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Course" Binding="{Binding CourseName}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="70"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding EnrollmentDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
