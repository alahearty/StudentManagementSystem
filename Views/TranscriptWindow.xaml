<Window x:Class="StudentManagementSystem.Views.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Transcript" Height="580" Width="820"
        ResizeMode="CanResize" MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Loaded="TranscriptWindow_Loaded">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8" Padding="8"
                        Width="36" Height="36" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4C4;" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="{Binding StudentName}"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding RegistrationNumber}"/>  ·  <Run Text="{Binding Department}"/>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="CGPA" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CumulativeGpa, StringFormat={}{0:F2}}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource BackgroundBrush}"
                        CornerRadius="8" Padding="14,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Honors" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Honors}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Summary Cards -->
        <WrapPanel Grid.Row="1" Margin="20,14,20,0">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    Padding="14,10" Margin="0,0,10,8" MinWidth="140"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total Courses" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalCourses}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    Padding="14,10" Margin="0,0,10,8" MinWidth="140"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total Credits" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalCredits}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Two-Panel: Semester GPA + Course Details -->
        <Grid Grid.Row="2" Margin="20,8,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Semester Summaries -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Semester GPA" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding SemesterSummaries}"
                              Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="4"
                                        Background="{StaticResource BackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Semester}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding Courses, StringFormat={}{0} courses}"/>
                                                <Run Text=", "/><Run Text="{Binding Credits, StringFormat={}{0} cr}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Gpa, StringFormat={}{0:F2}}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Course Details -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Course Details" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}"
                          Style="{StaticResource ModernDataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F9FAFB" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Course Code" Binding="{Binding CourseCode}" Width="85"/>
                        <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="150"/>
                        <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="90"/>
                        <DataGridTextColumn Header="Credits" Binding="{Binding Credits}" Width="55"/>
                        <DataGridTextColumn Header="CA" Binding="{Binding CaScore}" Width="45"/>
                        <DataGridTextColumn Header="Exam" Binding="{Binding ExamScore}" Width="55"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalScore}" Width="50"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="55">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="GP" Binding="{Binding GradePoint}" Width="45"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding EnrollmentDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export PDF"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ExportPdf_Click"
                        Margin="0,0,10,0"/>
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CloseCommand}" MinWidth="80"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
